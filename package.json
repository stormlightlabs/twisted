{
	"name": "twisted",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc && vite build",
		"preview": "vite preview",
		"format": "prettier --write . --ignore-unknown",
		"format:check": "prettier --check . --ignore-unknown",
		"test:e2e": "cypress run",
		"test:unit": "vitest",
		"test:smoke": "hurl --test --jobs 1 --delay 250 --retry 2 --retry-interval 2000 --variables-file tests/smoke/fixture.env tests/smoke/*.hurl",
		"lint": "eslint ."
	},
	"dependencies": {
		"@atcute/client": "5.1.1",
		"@atcute/lexicons": "2.0.3",
		"@atcute/microcosm": "2.0.2",
		"@atcute/tangled": "2.0.13",
		"@bruits/satteri-wasm32-wasi": "0.9.5",
		"@capacitor/app": "8.1.1",
		"@capacitor/core": "8.5.0",
		"@capacitor/haptics": "8.0.2",
		"@capacitor/keyboard": "8.0.5",
		"@capacitor/status-bar": "8.0.3",
		"@fontsource-variable/azeret-mono": "^5.3.0",
		"@fontsource-variable/commissioner": "^5.3.0",
		"@ionic/vue": "^8.0.0",
		"@ionic/vue-router": "^8.0.0",
		"dompurify": "3.4.12",
		"ionicons": "^7.0.0",
		"satteri": "0.9.5",
		"vue": "^3.3.0",
		"vue-router": "^4.2.0"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.0",
		"@eslint/js": "10.0.1",
		"@vitejs/plugin-vue": "^4.0.0",
		"@vue/eslint-config-typescript": "14.9.0",
		"@vue/test-utils": "^2.3.0",
		"cypress": "^13.5.0",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-unicorn": "72.0.0",
		"eslint-plugin-vue": "10.10.0",
		"globals": "17.8.0",
		"jsdom": "^22.1.0",
		"prettier": "3.9.6",
		"terser": "^5.4.0",
		"typescript": "~5.9.0",
		"vite": "^5.0.0",
		"vitest": "^0.34.6",
		"vue-tsc": "^2.1.10"
	},
	"description": "A read-only Tangled client"
}
