# Bobbin needs both upstream services. Tangled does not currently publish
# general-purpose Hydrant or Slingshot instances.
BOBBIN_HYDRANT_URL=wss://hydrant.example.com
BOBBIN_SLINGSHOT_URL=https://slingshot.example.com

# The browser-facing gateway listens on this host port.
BOBBIN_PORT=8090

# Optional tuning.
BOBBIN_LOG=info
BOBBIN_LOG_FORMAT=json
BOBBIN_RECORD_LRU_BYTES=67108864
BOBBIN_SEARCH_HEAP_BYTES=50000000

