# Public upstreams used by the local Bobbin development stack.
BOBBIN_HYDRANT_URL=https://hydrant.klbr.net/
BOBBIN_SLINGSHOT_URL=https://slingshot.microcosm.blue

# The browser-facing gateway listens on this host port.
BOBBIN_PORT=8090

# Optional tuning.
BOBBIN_LOG=info
BOBBIN_LOG_FORMAT=json
BOBBIN_RECORD_LRU_BYTES=67108864
BOBBIN_SEARCH_HEAP_BYTES=50000000
